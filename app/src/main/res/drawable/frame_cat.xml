<?xml version="1.0" encoding="utf-8"?>
<!-- Фон аватара «Кот»: градиентный диск, светящиеся уши и пульсирующее свечение. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <!-- оранжевое свечение -->
            <path
                android:name="glow"
                android:pathData="M24,24 m-18,0 a18,18 0 1,1 36,0 a18,18 0 1,1 -36,0"
                android:strokeColor="#73FFB74D"
                android:strokeWidth="9"
                android:fillColor="#00000000" />
            <!-- диск с оранжевым градиентом -->
            <path
                android:name="disc"
                android:pathData="M24,24 m-17.3,0 a17.3,17.3 0 1,1 34.6,0 a17.3,17.3 0 1,1 -34.6,0">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#FFB74D"
                        android:endColor="#E65100" />
                </aapt:attr>
            </path>
            <!-- светящиеся уши позади иконки, слегка покачиваются -->
            <group android:name="ears" android:pivotX="24" android:pivotY="14">
                <path
                    android:name="ear_left_glow"
                    android:pathData="M6.5,18 L12.5,0 L27.5,11.5 Z"
                    android:fillColor="#99FFB74D" />
                <path
                    android:name="ear_right_glow"
                    android:pathData="M41.5,18 L35.5,0 L20.5,11.5 Z"
                    android:fillColor="#99FFB74D" />
                <path
                    android:name="ear_left"
                    android:pathData="M9,16.5 L12.8,1.5 L25,11 Z"
                    android:fillColor="#FF9800" />
                <path
                    android:name="ear_right"
                    android:pathData="M39,16.5 L35.2,1.5 L23,11 Z"
                    android:fillColor="#FF9800" />
            </group>
            <!-- блики на ободе -->
            <path
                android:name="shine"
                android:pathData="M24,24 m-15.5,0 a15.5,15.5 0 0,1 11,-14.8"
                android:strokeColor="#66FFFFFF"
                android:strokeWidth="1.6"
                android:strokeLineCap="round"
                android:fillColor="#00000000" />
        </vector>
    </aapt:attr>
    <target android:name="glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:duration="1300"
                android:valueFrom="0.55"
                android:valueTo="0.95"
                android:repeatCount="-1"
                android:repeatMode="reverse" />
        </aapt:attr>
    </target>
    <target android:name="ears">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:duration="900"
                android:valueFrom="-2"
                android:valueTo="2"
                android:repeatCount="-1"
                android:repeatMode="reverse" />
        </aapt:attr>
    </target>
</animated-vector>
