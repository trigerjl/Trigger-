<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_dark"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".PinActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/iv_pin_lock"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_pin_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/pin_title"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_pin_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/pin_error_min_4"
            android:textColor="#B8B8C8"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/ll_pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pin_dot_empty" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pin_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#FCA5A5"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pin_biometric"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/pin_biometric_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_fingerprint"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/white"
            app:strokeColor="#55FFFFFF"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pin_fallback"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/pin_enter_pin_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:strokeColor="#55FFFFFF"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_key_1"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_1"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btn_key_2"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_2"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btn_key_3"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_3"
                    android:textColor="@color/white"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_key_4"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_4"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btn_key_5"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_5"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btn_key_6"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_6"
                    android:textColor="@color/white"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_key_7"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_7"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btn_key_8"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_8"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btn_key_9"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_9"
                    android:textColor="@color/white"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_key_delete"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_delete"
                    android:textColor="@color/white"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/btn_key_0"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/pin_key_0"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btn_key_ok"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pin_key_ok"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/action_ok"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_forgot_pin"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/pin_forgot"
            android:textAllCaps="false"
            android:textColor="#B8B8C8"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/ll_pin_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pin_skip"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/action_skip"
                android:textAllCaps="false"
                android:textColor="#B8B8C8"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pin_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:text="@string/action_cancel"
                android:textAllCaps="false"
                android:textColor="#B8B8C8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
