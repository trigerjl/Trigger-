<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_icon_accent">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@color/accent_purple" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_pin_sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/pin_change_title"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_pin_sheet_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/pin_security_hint"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/fl_pin_current"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/accent_purple" />

            <EditText
                android:id="@+id/et_pin_current"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints=""
                android:background="@drawable/bg_input_rounded"
                android:digits="0123456789"
                android:gravity="center_vertical|start"
                android:hint="@string/pin_current_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number|numberPassword"
                android:letterSpacing="0.12"
                android:maxLength="6"
                android:maxLines="1"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary_dark"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_toggle_current"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pin_show"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary_dark" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fl_pin_new"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/accent_purple" />

            <EditText
                android:id="@+id/et_pin_new"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints=""
                android:background="@drawable/bg_input_rounded"
                android:digits="0123456789"
                android:gravity="center_vertical|start"
                android:hint="@string/pin_new_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number|numberPassword"
                android:letterSpacing="0.12"
                android:maxLength="6"
                android:maxLines="1"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary_dark"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_toggle_new"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pin_show"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary_dark" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ll_pin_strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_strength_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pin_strength_bar" />

                <View
                    android:id="@+id/view_strength_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pin_strength_bar" />

                <View
                    android:id="@+id/view_strength_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pin_strength_bar" />

                <View
                    android:id="@+id/view_strength_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pin_strength_bar" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_pin_strength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fl_pin_confirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/accent_purple" />

            <EditText
                android:id="@+id/et_pin_confirm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints=""
                android:background="@drawable/bg_input_rounded"
                android:digits="0123456789"
                android:gravity="center_vertical|start"
                android:hint="@string/pin_confirm_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number|numberPassword"
                android:letterSpacing="0.12"
                android:maxLength="6"
                android:maxLines="1"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary_dark"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_toggle_confirm"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pin_show"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary_dark" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_rounded"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pin_requirements_title"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_req_length"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="@color/text_secondary_dark" />

                <TextView
                    android:id="@+id/tv_req_length"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/pin_req_length"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_req_repeat"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="@color/text_secondary_dark" />

                <TextView
                    android:id="@+id/tv_req_repeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/pin_req_unique"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pin_sheet_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/danger_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_pin_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/pin_warning"
            android:textColor="@color/accent_orange"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pin_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/pin_change_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_purple"
            app:cornerRadius="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pin_secondary"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/action_delete"
                android:textAllCaps="false"
                android:textColor="@color/danger_red"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pin_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/action_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
