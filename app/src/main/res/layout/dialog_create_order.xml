<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <Spinner
            android:id="@+id/spinner_order_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/et_order_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exchange_order_amount_hint"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_order_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exchange_order_price_hint"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/spinner_order_currency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spinner_order_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/et_order_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exchange_order_details_hint"
            android:inputType="text"
            android:maxLines="3" />
    </LinearLayout>
</ScrollView>
