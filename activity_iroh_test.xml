<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?android:attr/colorBackground"
    tools:context=".IrohTestActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iroh: тест подключения"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tv_iroh_my_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:text="Мой Endpoint ID: запускается..."
        android:textColor="?android:attr/textColorSecondary" />

    <EditText
        android:id="@+id/et_iroh_peer_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Endpoint ID собеседника"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:maxLines="2"
        android:autofillHints="" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_iroh_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Подключиться"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button" />

    <TextView
        android:id="@+id/tv_iroh_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Статус: ожидание"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_iroh_open_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Открыть чат"
        android:textAllCaps="false"
        android:visibility="gone"
        app:icon="@drawable/ic_chat"
        app:iconGravity="textStart"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
